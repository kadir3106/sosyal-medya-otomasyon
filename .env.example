# Copy to .env and fill in real values. Never commit .env.

# Core
MEDIA_DIR=/data/media
TZ=Europe/Istanbul
VIDEO_SCHEDULE_HOUR=9
IMAGE_SCHEDULE_HOUR=12
VIDEO_LANG=en
VIDEO_VOICE=
VIDEO_VOICE_RATE=+12%
VIDEO_FORMAT=cinematic
CINEMATIC_GRADE=true
VISUAL_ENGINE=stock
# AI Director — creative scene plan then type-aware fetch. Default OFF (legacy path).
# Model selection is AI router's job via LLM_API_URL; Director only plans visuals.
DIRECTOR_ENABLED=false
DIRECTOR_AI_IMAGE_MAX=2
DIRECTOR_RELEVANCE_MIN=0.2
# Default: stock video (Pexels→Pixabay→Mixkit) + light Ken Burns. Opt-in AI: flux_kenburns | hybrid | kling
# When true, Flux miss may also fall through to topic-anchored stock.
ALLOW_STOCK_FALLBACK=true
ENABLE_SFX=true
# Keyword emoji on ASS captions (💰🚀). Default off — cinematic luxury path.
ENABLE_SUBTITLE_EMOJIS=false
# Inject winning YouTube context + local winning_hooks.json ledger into LLM prompts.
# LIVE: YouTube top performer via channel_growth (needs YT creds).
# STUB: local MEDIA_DIR/winning_hooks.json store/load (no YT required).
# Default false — enable after you have published samples; adds API cost/latency.
ENABLE_ANALYTICS_MEMORY=false
# Kling only when VISUAL_ENGINE=kling|hybrid (default Flux path ignores this).
KLING_MAX_SCENES=1

# Topics — niche lock: EN daily MUST be topics_dark_wealth.json.
# trivia topics.json / space-ants pools are remapped away at config + select time.
# TR path is separate; leave TOPICS_PATH_TR alone for Turkish voiceovers.
TOPICS_PATH=/app/data/topics_dark_wealth.json
TOPICS_PATH_TR=/app/data/video_topics_tr.json
IMAGE_TOPICS_PATH=/app/data/image_topics.json
BGM_DIR=/data/media/audio/bgm
TUNNEL_LOG_PATH=/tunnel-logs/tunnel.log

# LLM (OpenRouter or compatible gateway, e.g. airouter)
OPENROUTER_API_KEY=
# Primary model — MUST be set for Docker (compose passes OPENROUTER_MODEL into video-worker).
# airouter model ids (from GET /v1/models): groq/qwen/qwen3.8-27b, gemini-flash, smart, auto
# OpenRouter example: OPENROUTER_MODEL=anthropic/claude-sonnet-4
# Do NOT use OpenRouter :free ids (e.g. google/gemma-4-31b-it:free) against airouter → HTTP 400.
OPENROUTER_MODEL=
OPENROUTER_MODEL_SECONDARY=
# Waterfall last resort — airouter-safe default (gemini-flash / smart). Override if needed.
OPENROUTER_MODEL_FALLBACK=gemini-flash
# Docker → host airouter: http://host.docker.internal:20128/v1/chat/completions
# Host PowerShell / browser: http://127.0.0.1:20128/v1/chat/completions
LLM_API_URL=

# Telegram approval loop
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DIGEST_HOUR=21
DIGEST_INTERVAL_SECONDS=300

# Stock / AI media
PEXELS_API_KEY=
# Optional second stock provider (https://pixabay.com/api/docs/)
PIXABAY_API_KEY=
# Mixkit HTML search fallback (no API key). Set false to skip.
ENABLE_MIXKIT_STOCK=true
# Fal.ai — only needed for VISUAL_ENGINE=flux_kenburns|hybrid|kling
FAL_KEY=
# Quality bar: ElevenLabs required for production path (word timestamps + natural voice).
# Missing key → Edge Neural + VIDEO_VOICE_RATE (robotic / "slop"); pipeline soft-warns + Telegram note.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# YouTube
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_API_KEY=
YOUTUBE_PRIVACY_STATUS=public

# TikTok
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_AUDITED=false
TIKTOK_TOKEN_PATH=/data/tiktok-token/token.json

# Meta (Instagram / Facebook)
META_IG_USER_ID=
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=

# Threads / X / LinkedIn / Pinterest (optional)
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REFRESH_TOKEN=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REFRESH_TOKEN=
LINKEDIN_AUTHOR_URN=
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
PINTEREST_REFRESH_TOKEN=
PINTEREST_BOARD_ID=

# Image cards
IMAGE_BRAND_NAME=KALI
IMAGE_ACCENT=#38BDF8

# n8n setup script
N8N_EMAIL=admin@local.dev
N8N_PASSWORD=
