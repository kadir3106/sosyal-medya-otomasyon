# Copy to .env and fill in real values. Never commit .env.

# Core
MEDIA_DIR=/data/media
TZ=Europe/Istanbul
VIDEO_SCHEDULE_HOUR=9
IMAGE_SCHEDULE_HOUR=12
VIDEO_LANG=en
VIDEO_VOICE=
VIDEO_VOICE_RATE=+12%
VIDEO_FORMAT=cinematic
CINEMATIC_GRADE=true
VISUAL_ENGINE=hybrid
ENABLE_SFX=true
# Inject winning YouTube hooks into LLM prompts (reads published_log + YT stats).
# Default false — enable only after you have enough published samples; adds API cost/latency.
ENABLE_ANALYTICS_MEMORY=false
KLING_MAX_SCENES=3

# LLM (OpenRouter or compatible gateway)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_MODEL_SECONDARY=
OPENROUTER_MODEL_FALLBACK=google/gemma-4-31b-it:free
LLM_API_URL=

# Telegram approval loop
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DIGEST_HOUR=21
DIGEST_INTERVAL_SECONDS=300

# Stock / AI media
PEXELS_API_KEY=
FAL_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# YouTube
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_API_KEY=
YOUTUBE_PRIVACY_STATUS=public

# TikTok
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_AUDITED=false
TIKTOK_TOKEN_PATH=/data/tiktok-token/token.json

# Meta (Instagram / Facebook)
META_IG_USER_ID=
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=

# Threads / X / LinkedIn / Pinterest (optional)
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REFRESH_TOKEN=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REFRESH_TOKEN=
LINKEDIN_AUTHOR_URN=
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
PINTEREST_REFRESH_TOKEN=
PINTEREST_BOARD_ID=

# Image cards
IMAGE_BRAND_NAME=KALI
IMAGE_ACCENT=#38BDF8

# n8n setup script
N8N_EMAIL=admin@local.dev
N8N_PASSWORD=
