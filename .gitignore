# Secrets & local env
.env
.env.*
!.env.example
*.pem
*.key
*credentials*.json
*token*.json
.tiktok_pkce.json
**/tiktok_session/
**/tiktok_session/**

# Local media / session junk (keep branding assets + audio SFX tracked)
backups/*
!backups/.gitkeep
*.tar.gz
# Git bundle = tüm geçmişin kopyası; sızan nesneleri (tiktok_session profili,
# n8n encryptionKey) taşır. Depo içine asla girmemeli.
*.bundle
# `scripts/seal_leak_copies.py` çıktısı: mühürlü ama yine de bir yedek kopya.
# Commit'lenmesi, sırrı şifreli de olsa yaymak olur.
*.sealed
video-output/*
!video-output/.gitkeep
!video-output/branding/
!video-output/branding/**
!video-output/audio/
!video-output/audio/**

# Extra session / runtime guards
video-output/tiktok_session/
video-output/tiktok_session/**
video-output/work/
video-output/failed/
video-output/jobs.db
video-output/jobs.db-*

# Build / runtime
*.mp4
*.mp3
node_modules/
__pycache__/
.venv/
dist/
output/
.cache/
.pytest_cache/
*.pyc
.DS_Store
