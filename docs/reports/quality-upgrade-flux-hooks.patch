+def topic_anchor_terms(topic: str, max_terms: int = 4) -> list[str]:
+    """Concrete nouns/proper names from the topic (e.g. Rolex, Swiss, trust)."""
+    if not topic:
+        return []
+    words = re.findall(r"[A-Za-z\u00C0-\u024F]+", topic)
+    anchors = []
+    for word in words:
+        lower = word.lower()
+        if lower in _STOPWORDS or lower in _GENERIC_STOCK_TERMS:
+            continue
+        if len(lower) < 3 and not word[:1].isupper():
+            continue
+        if lower not in anchors:
+            anchors.append(lower if word.islower() else word)
+        if len(anchors) >= max_terms:
+            break
+    return anchors
+
+
+def prompt_concrete_terms(prompt: str, max_terms: int = 3) -> list[str]:
+    """Strip cinematic fluff; keep subject nouns for Pexels search."""
+    if not prompt:
+        return []
+    words = [
+        w.strip(".,:;'\"()-")
+        for w in prompt.replace(",", " ").split()
+    ]
+    kept = []
+    for word in words:
+        lower = word.lower()
+        if len(lower) < 4 or lower in _PROMPT_NOISE or lower in _STOPWORDS:
+            continue
+        if lower not in kept:
+            kept.append(lower)
+        if len(kept) >= max_terms:
+            break
+    return kept
+
+
+def build_scene_search_query(
+    topic: str,
+    prompt: str = "",
+    keyword_hint: str | None = None,
+    scene_index: int = 0,
+) -> str:
+    """Per-scene Pexels query anchored to the topic — never bare 'luxury business'."""
+    anchors = topic_anchor_terms(topic)
+    concrete = prompt_concrete_terms(prompt)
+    hint = (keyword_hint or "").strip()
+    hint_l = hint.lower()
+
+    parts: list[str] = []
+    # Rotate which topic anchors lead so scenes don't all hit the same page-1 clip.
+    if anchors:
+        rotated = anchors[scene_index % len(anchors):] + anchors[: scene_index % len(anchors)]
+        parts.extend(rotated[:2])
+    for term in concrete:
+        if term.lower() not in {p.lower() for p in parts}:
+            parts.append(term)
+        if len(parts) >= 4:
+            break
+    if hint and hint_l not in _GENERIC_STOCK_TERMS and hint_l not in {p.lower() for p in parts}:
+        parts.append(hint)
+
+    query = " ".join(parts[:5]).strip()
+    if not query or query.lower() in _GENERIC_STOCK_TERMS:
+        # Last resort: keep topic text itself (truncated) over generic wealth stock.
+        fallback = " ".join(topic_anchor_terms(topic, max_terms=5)) or (topic or "").strip()
+        query = fallback[:80] if fallback else "swiss watch craftsmanship"
+    return query
