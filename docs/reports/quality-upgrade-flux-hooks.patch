+# Auth/billing sinyalleri — HTTP 401/403 dışında body'de de görülebilir (402, FAILED).
+_AUTH_BILLING_MARKERS = (
+    "exhausted balance",
+    "user is locked",
+    "insufficient credit",
+    "insufficient balance",
+    "payment required",
+    "billing",
+    "unauthorized",
