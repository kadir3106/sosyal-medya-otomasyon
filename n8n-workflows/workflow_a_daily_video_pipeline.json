{
  "name": "Daily Video Pipeline",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1,
              "triggerAtHour": 9,
              "triggerAtMinute": 0
            }
          ]
        }
      },
      "id": "a1-schedule",
      "name": "Daily 09:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.VIDEO_WORKER_URL}}/generate",
        "options": {
          "timeout": 300000
        }
      },
      "id": "a2-generate",
      "name": "Generate Video",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 0],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{$env.TELEGRAM_BOT_TOKEN}}/sendMessage",
        "sendBody": true,
        "bodyContentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "chat_id",
              "value": "={{$env.TELEGRAM_CHAT_ID}}"
            },
            {
              "name": "text",
              "value": "=⚠️ Bugün video üretilemedi: {{$json.error?.message || 'bilinmeyen hata'}}"
            }
          ]
        }
      },
      "id": "a3-error",
      "name": "Send Generation Error",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, -160]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{$env.VIDEO_WORKER_URL}}/media/{{$json.video_filename}}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file",
              "outputPropertyName": "data"
            }
          }
        }
      },
      "id": "a4-download",
      "name": "Download Video File",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 0]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "sendVideo",
        "chatId": "={{$env.TELEGRAM_CHAT_ID}}",
        "binaryData": true,
        "video": "={{$json.data}}",
        "caption": "=🎬 {{$('Generate Video').item.json.title}}\n\n{{$('Generate Video').item.json.description}}\n\n🪝 Hook: \"{{($('Generate Video').item.json.quality?.hook) || '?'}}\"\n⚙️ tekrar {{($('Generate Video').item.json.quality?.clip_reuse_ratio) || '?'}}x · TTS {{($('Generate Video').item.json.quality?.tts) || '?'}} · {{($('Generate Video').item.json.quality?.engine) || '?'}}{{$('Generate Video').item.json.quality?.warning === 'clip_reuse_ratio_high' ? ' ⚠️ TEKRAR YÜKSEK' : ($('Generate Video').item.json.quality?.warning === 'tts_edge_fallback' ? ' ⚠️ Edge TTS' : ($('Generate Video').item.json.quality?.warning ? ' ⚠️ ' + $('Generate Video').item.json.quality.warning : ''))}}",
        "additionalFields": {}
      },
      "id": "a5-approval",
      "name": "Send Approval Request",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [660, 0],
      "credentials": {
        "telegramApi": {
          "id": "__TELEGRAM_CRED_ID__",
          "name": "Telegram - Otomasyon Bot"
        }
      }
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "={{$env.TELEGRAM_CHAT_ID}}",
        "text": "=Yukarıdaki videoyu onaylıyor musun?",
        "additionalFields": {
          "reply_markup": {
            "inline_keyboard": {
              "rows": {
                "row": [
                  {
                    "text": "✅ Onayla",
                    "additionalFields": {
                      "callbackData": "approve"
                    }
                  },
                  {
                    "text": "❌ Reddet",
                    "additionalFields": {
                      "callbackData": "reject"
                    }
                  }
                ]
              }
            }
          }
        }
      },
      "id": "a6-buttons",
      "name": "Send Buttons",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [880, 0],
      "credentials": {
        "telegramApi": {
          "id": "__TELEGRAM_CRED_ID__",
          "name": "Telegram - Otomasyon Bot"
        }
      }
    }
  ],
  "connections": {
    "Daily 09:00": {
      "main": [
        [
          {
            "node": "Generate Video",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Generate Video": {
      "main": [
        [
          {
            "node": "Download Video File",
            "type": "main",
            "index": 0
          }
        ]
      ],
      "error": [
        [
          {
            "node": "Send Generation Error",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Download Video File": {
      "main": [
        [
          {
            "node": "Send Approval Request",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Approval Request": {
      "main": [
        [
          {
            "node": "Send Buttons",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "active": false
}
